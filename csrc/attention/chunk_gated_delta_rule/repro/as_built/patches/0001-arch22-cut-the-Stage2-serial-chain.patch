+        }
+    }
+
+    // B stored (k, n) in L1 as Nz with kAlign rows: transpose loads into L0B (Zn layout).
+    __aicore__ inline void LoadBKn(LocalTensor<bfloat16_t> &l0Tensor, LocalTensor<bfloat16_t> &l1Tensor,
