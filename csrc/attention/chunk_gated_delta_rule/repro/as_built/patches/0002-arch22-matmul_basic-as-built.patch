+++ b/attention/chunk_gated_delta_rule/op_kernel/chunk_gated_delta_rule_matmul_basic.h
@@ -145,13 +145,16 @@ public:
 
         SetFlag<HardEvent::MTE1_M>(MM_FWD_ID[p]);
 
-        // (3) Mmad —— unitFlag=0b11：Mmad 按 16 行单元逐个放行 Fixpipe，硬件接力，
-        // 免掉 M->FIX 的 flag 对，且 Fixpipe 可与 Mmad 尾部重叠
+        // (3) Mmad
         WaitFlag<HardEvent::MTE1_M>(MM_FWD_ID[p]);
 
         DoMmad(l0cTensor_[p], l0aTensor_[p], l0bTensor_[p], m, n, k);
 
