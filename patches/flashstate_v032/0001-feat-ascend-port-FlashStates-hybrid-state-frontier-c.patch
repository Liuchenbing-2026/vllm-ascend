@@ -0,0 +1,27 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The prefill cost that GreedyDual-Size eviction saves by keeping a unit."""
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True, slots=True)
+class PrefillCostModel:
+    """Seconds to prefill positions ``[a, b)``: ``per_token`` seconds per token
+    plus ``per_token_per_100k`` seconds per token per 100,000 tokens of
+    position, the attention term that grows with context.
+
+    GreedyDual-Size ranks units by ``stamp + gain / size`` with ``stamp``
+    itself a past score, so scaling both coefficients by a constant does not
+    change the eviction order; only their ratio matters.
+    """
+
+    per_token: float
+    per_token_per_100k: float
+
+    def seconds(self, a: int, b: int) -> float:
+        if b <= a:
+            return 0.0
+        return (b - a) * self.per_token + self.per_token_per_100k * (
+            b * b - a * a
+        ) / 2e5
diff --git a/vllm/v1/core/hybrid_checkpoint/eviction.py b/vllm/v1/core/hybrid_checkpoint/eviction.py
new file mode 100644
index 0000000..89e342c
--- /dev/null
+++ b/vllm/v1/core/hybrid_checkpoint/eviction.py
@@ -0,0 +1,845 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GreedyDual-Size eviction of recovery units (``prefix_cache_eviction="gds"``).
+
+The free queue stays the only source of truth for which block an allocation
+takes; before an allocation would take a cached block, this policy moves the
+blocks it chooses to the front.
+
+A unit is a recovery unit (``units.RecoveryUnit``) with the pages only it
+needs: the suffix of its path (the attention page keys of the full blocks
+before it) that no other unit's path holds. A cached free block that is
+neither a unit's state block nor a page on a unit's path is an orphan and
+serves no hit.
+
+``gain`` is the prefill seconds of ``[fallback, num_tokens)``, the fallback
+being the deepest unit before it on its path (an aligned unit among its page
+keys, or its graph parent), or position 0; a unit that can no longer be hit
+(a page on its path was lost) has gain 0. ``size`` is the number of blocks
+freed if it goes: its state blocks (every group for a frontier, the Mamba
+groups for a block-boundary unit) and its exclusive pages. A unit is used
+when it is cached, resumed at or its state blocks are released by a request,
+and ``stamp`` is the clock ``L`` then. The score is ``stamp + gain / size``,
+lowest first; ``L`` is the score of the last evicted unit, and an orphan
+scores ``L``.
+
+Before an allocation takes a cached block, the keyless free blocks at the
+queue front go first; then the free unit with the lowest score goes whole
+(its state blocks, then its pages, deepest first): its keys are dropped and
+its blocks go to the front. A popped entry whose score grew is pushed again
+at its score; a change that lowers a score pushes the unit at once. Units a
+waiting request resumes at and units a running request holds are parked
+until free and unpinned. With no free unit left, the pool's order stands,
+pinned blocks last, those of the waiting queue's back first: its head, the
+next request admitted, keeps its hit longest. A new unit whose score is below
+every other unit's when its blocks are first free is released at once while
+the pool has no keyless free block.
+"""
+
+import heapq
+import itertools
+import time
+from collections import deque
+from collections.abc import Callable, Iterable
+from typing import TYPE_CHECKING
+
+from vllm.v1.core.hybrid_checkpoint.cost import PrefillCostModel
+from vllm.v1.core.hybrid_checkpoint.frontier import FrontierIndex
+from vllm.v1.core.hybrid_checkpoint.units import CheckpointGraph, RecoveryUnit
+from vllm.v1.core.kv_cache_utils import (
+    BlockHash,
+    BlockHashWithGroupId,
+    KVCacheBlock,
+    get_block_hash,
+    get_group_id,
+    make_block_hash_with_group_id,
+)
+from vllm.v1.kv_cache_interface import MambaSpec
+
+if TYPE_CHECKING:
+    from vllm.v1.core.kv_cache_coordinator import KVCacheCoordinator
+    from vllm.v1.request import Request
+
+# Removed units whose fallback is kept for the units that pointed at them,
+# beyond twice the live units.
+_GONE = 1024
+# The heap is rebuilt from its live entries past this many per live entry.
+_HEAP_FACTOR = 4
+_HEAP_SLACK = 1024
+# Waiting requests whose prefix hits pin units, the hash units their lookups
+# may walk in all (the queue's front first), and the least time between
+# refreshes of that set.
+_PIN_WINDOW = 256
+_PIN_UNITS = 1 << 18
+_PIN_REFRESH_S = 0.5
+# Leaf-last tiers, lowest first.
+_DEAD, _INNER, _LEAF = 0, 1, 2
+# Their names in KV cache events.
+TIER_NAMES = {_DEAD: "dead", _INNER: "interior", _LEAF: "leaf"}
+
+# (score, sequence, unit key or orphan block); the score is (score,), or
+# (tier, score) with leaf-last tiers. A unit's entry is current while the
+# unit's version is the entry's sequence.
+_Score = tuple[float, ...]
+_Entry = tuple[_Score, int, BlockHash | KVCacheBlock]
+
+
+class GreedyDualSizeEviction:
+    """The ``CachedBlockEvictionPolicy`` of the coordinator's block pool and
+    the observer of the checkpoint graph's units.
+
+    Args:
+        coordinator: The KV cache coordinator; every group's blocks come from
+            its block pool.
+        graph: The recovery units this policy ranks.
+        frontiers: The frontier checkpoints, for waiting requests' hits.
+        cost: The prefill cost model behind each unit's gain.
+        waiting: The waiting requests, first to be scheduled first.
+        leaf_last: Evict every inner unit before any leaf. A unit with a
+            deeper live unit on its path (among the units holding its key as a
+            page, or its graph children) is inner unless it is a branch point;
+            the score is (tier, score) with dead 0, inner 1 and leaf 2, and
+            ``L`` rises only when a leaf goes.
+        leaf_idle_s: With ``leaf_last``, a leaf (not a branch point) unused
+            for this many seconds ranks as inner.
+
+    """
+
+    def __init__(
+        self,
+        coordinator: "KVCacheCoordinator",
+        graph: CheckpointGraph,
+        frontiers: FrontierIndex,
+        cost: PrefillCostModel,
+        waiting: Callable[[], Iterable["Request"]],
+        *,
+        leaf_last: bool = False,
+        leaf_idle_s: float | None = None,
+    ) -> None:
+        self.coordinator = coordinator
+        self.leaf_last = leaf_last
+        self._demote_s = leaf_idle_s if leaf_last else None
+        # leaf_idle_s: (time of a use, unit key), oldest first.
+        self._recent: deque[tuple[float, BlockHash]] = deque()
+        self.pool = coordinator.block_pool
+        assert all(
+            m.block_pool is self.pool for m in coordinator.single_type_managers
+        ), "GreedyDual-Size eviction orders one block pool"
+        self.frontiers = frontiers
+        self.cost = cost
+        self.waiting = waiting
+        self.block_size = coordinator.scheduler_block_size
+        self.hashes_per_block = self.block_size // self.pool.hash_block_size
+        groups = coordinator.kv_cache_config.kv_cache_groups
+        self.mamba = tuple(
+            i for i, g in enumerate(groups) if isinstance(g.kv_cache_spec, MambaSpec)
+        )
+        self.every = tuple(range(len(groups)))
+        self.page_groups = tuple(i for i in self.every if i not in self.mamba)
+        self.clock = 0.0
+        # Unit key -> the page keys of the full blocks before it.
+        self.paths: dict[BlockHash, tuple[BlockHash, ...]] = {}
+        self.units: dict[BlockHash, RecoveryUnit] = {}
+        # Page key -> keys of the units whose path holds it (removed keys
+        # linger until settle).
+        self.on_path: dict[BlockHash, set[BlockHash]] = {}
+        self.heap: list[_Entry] = []
+        self._seq = itertools.count()
+        self._gone: dict[BlockHash, BlockHash | None] = {}
+        self._removed_units: list[RecoveryUnit] = []
+        self._parked: dict[BlockHash, RecoveryUnit] = {}
+        # Units not yet admitted: blocks not free, or path unknown.
+        self._fresh: set[BlockHash] = set()
+        # Ids of the blocks with a live orphan entry.
+        self._orphans: set[int] = set()
+        # Block id -> rank of the first waiting request whose hit reads it.
+        self._pinned_blocks: dict[int, int] = {}
+        self._pinned_at = float("-inf")
+        self.num_evicted_units = 0
+        self.num_evicted_blocks = 0
+        # The unit an eviction is dropping now, and the blocks it frees.
+        self.evicting: BlockHash | None = None
+        self.evicting_blocks = 0
+        graph.observer = self
+
+    # Graph events.
+    def unit_added(self, unit: RecoveryUnit) -> None:
+        self._use(unit)
+        self.units[unit.key] = unit
+        self._fresh.add(unit.key)
+        path = self.paths.get(unit.key)
+        if path:
+            self._index(unit, path)
+        self._push(unit)
+
+    def unit_recached(self, unit: RecoveryUnit) -> None:
+        """Another copy of a cached unit: more blocks free when it goes."""
+        if unit.key in self.units:
+            unit.dirty = True
+            self._push(unit)
+
+    def unit_removed(self, unit: RecoveryUnit) -> None:
+        if self.units.get(unit.key) is unit:
+            self._drop(unit)
+        if self.leaf_last and unit.parent is not None:
+            # Its children moved up to its parent, which may be a branch point
+            # no longer.
+            self._recheck(self.units.get(unit.parent))
+
+    def unit_used(self, unit: RecoveryUnit) -> None:
+        if unit.key in self.units:
+            self._use(unit)
+            self._push(unit)
+
+    def unit_linked(self, unit: RecoveryUnit) -> None:
+        """Its graph parent may be set now: its fallback."""
+        if unit.key in self.units:
+            fallback = unit.fallback
+            if self._fallback(unit) != fallback:
+                self._push(unit)
+            if self.leaf_last and unit.parent is not None:
+                # The parent has a deeper child now: it may be a leaf no longer.
+                self._recheck(self.units.get(unit.parent))
+
+    def record(self, key: BlockHash, num_tokens: int, request: "Request") -> None:
+        """``request`` cached the unit ``key`` at ``num_tokens``: its path."""
+        if key in self.paths:
+            return
+        hashes = request.block_hashes
+        n = min(num_tokens // self.block_size, len(hashes) // self.hashes_per_block)
+        path = tuple(hashes[(j + 1) * self.hashes_per_block - 1] for j in range(n))
+        self.paths[key] = path
+        unit = self.units.get(key)
+        if unit is not None and not unit.path:
+            self._index(unit, path)
+            self._push(unit)
+            if key in self._fresh and self._free(unit):
+                self._admit(unit)
+
+    # Block pool events.
+    def keys_removed(self, keys: list[BlockHashWithGroupId]) -> None:
+        """A unit whose path lost a page frees one block less when it goes;
+        with no copy of the page left, it cannot be hit. A state key that
+        never became a unit no longer needs its path."""
+        cached = self.pool.cached_block_hash_to_block
+        for grouped in keys:
+            if get_group_id(grouped) not in self.page_groups:
+                key = get_block_hash(grouped)
+                if key not in self.units:
+                    self.paths.pop(key, None)
+                continue
+            holders = self.on_path.get(get_block_hash(grouped))
+            if not holders:
+                continue
+            lost = cached.get_one_block(grouped) is None
+            for key in list(holders):
+                unit = self.units.get(key)
+                if unit is None:
+                    continue
+                unit.dirty = True
+                if lost and not unit.dead:
+                    unit.dead = True
+                    self._push(unit)
+
+    def on_blocks_freed(self, blocks: list[KVCacheBlock]) -> None:
+        """``blocks`` (cached) went back to the free queue. A unit whose state
+        block a request released was used now."""
+        released: dict[BlockHash, RecoveryUnit] = {}
+        for block in blocks:
+            needed = False
+            for grouped in self._keys(block):
+                key = get_block_hash(grouped)
+                unit = self.units.get(key)
+                if unit is not None:
+                    needed = True
+                    if unit.frontier or get_group_id(grouped) not in self.page_groups:
+                        released[key] = unit
+                elif get_group_id(grouped) in self.page_groups and any(
+                    k in self.units for k in self.on_path.get(key, ())
+                ):
+                    needed = True
+            if not needed and self._orphan(block):
+                self._push_orphan(block)
+        for key, unit in released.items():
+            self._use(unit)
+            if not self._free(unit):
+                continue
+            self._parked.pop(key, None)
+            self._push(unit)
+            if key in self._fresh and unit.path:
+                self._admit(unit)
+
+    def prepare_eviction(self, num_blocks: int) -> None:
+        """Before ``num_blocks`` blocks leave the front of the free queue."""
+        queue = self.pool.free_block_queue
+        block = queue.fake_free_list_head.next_free_block
+        for _ in range(num_blocks):
+            if block is None or block is queue.fake_free_list_tail:
+                return
+            if self._keyed(block):
+                break
+            block = block.next_free_block
+        else:
+            return
+        self._reorder(num_blocks)
+
+    # Units.
+    def _use(self, unit: RecoveryUnit) -> None:
+        unit.stamp = self.clock
+        if self._demote_s is not None:
+            unit.used_at = time.monotonic()
+            self._recent.append((unit.used_at, unit.key))
+
+    def _index(self, unit: RecoveryUnit, path: tuple[BlockHash, ...]) -> None:
+        """Put ``unit`` on its path's pages. A page it shares ends the chain of
+        the one unit that held it alone (that score grows: lazy); a unit
+        cached under deeper units becomes their fallback (their score drops:
+        pushed now)."""
+        unit.path = path
+        key, units, on_path = unit.key, self.units, self.on_path
+        for p in path:
+            holders = on_path.get(p)
+            if holders is None:
+                on_path[p] = {key}
+                continue
+            sole = self._sole(holders, key)
+            if sole is not None:
+                sole.dirty = True
+            holders.add(key)
+        unit.dirty = True
+        self._fallback(unit)
+        if self.leaf_last:
+            # The units on its path have a deeper unit now: a leaf among them
+            # becomes inner.
+            for p in path:
+                if p != key:
+                    self._recheck(units.get(p))
+        if unit.frontier:
+            return
+        for k in list(on_path.get(key, ())):
+            deeper = units.get(k)
+            if deeper is None or deeper is unit or deeper.num_tokens <= unit.num_tokens:
+                continue
+            fallback = self._resolve(deeper)
+            if fallback is None or units[fallback].num_tokens < unit.num_tokens:
+                deeper.fallback = key
+                deeper.dirty = True
+                self._push(deeper)
+
+    def _drop(self, unit: RecoveryUnit, orphans: bool = True) -> None:
+        """``unit`` left. Its pages no other unit holds are orphans (if still
+        cached and ``orphans``: an eviction drops their keys itself); the one
+        other unit on its deepest shared page takes that page and the ones
+        below it that only the two held (its score drops)."""
+        key = unit.key
+        if self.units.get(key) is not unit:
+            return
+        del self.units[key]
+        self._gone[key] = self._resolve(unit)
+        unit.version = -1
+        self._parked.pop(key, None)
+        self._fresh.discard(key)
+        self.paths.pop(key, None)
+        self._removed_units.append(unit)
+        units, cached = self.units, self.pool.cached_block_hash_to_block
+        for p in reversed(unit.path):
+            holders = self.on_path.get(p)
+            if holders is not None and any(k in units for k in holders):
+                owner = self._sole(holders, None)
+                if owner is not None:
+                    owner.dirty = True
+                    self._push(owner)
+                break
+            if not orphans:
+                continue
+            for group_id in self.page_groups:
+                grouped = make_block_hash_with_group_id(p, group_id)
+                for b in cached.get_all_blocks(grouped):
+                    if self._orphan(b):
+                        self._push_orphan(b)
+        if orphans:
+            for b in self._state_blocks(unit):
+                if self._orphan(b):
+                    self._push_orphan(b)
+        if self.leaf_last:
+            # A branch under the units on its path went, and its fallback lost
+            # a deeper unit: a branch point among them may be inner now.
+            for p in unit.path:
+                self._recheck(units.get(p))
+            fallback = self._gone.get(key)
+            if fallback is not None:
+                self._recheck(units.get(fallback))
+
+    def _sole(
+        self, holders: set[BlockHash], exclude: BlockHash | None
+    ) -> RecoveryUnit | None:
+        """The one live unit among ``holders`` other than ``exclude``."""
+        found = None
+        for k in holders:
+            if k != exclude:
+                unit = self.units.get(k)
+                if unit is not None:
+                    if found is not None:
+                        return None
+                    found = unit
+        return found
+
+    def _resolve(self, unit: RecoveryUnit) -> BlockHash | None:
+        fallback = unit.fallback
+        while fallback is not None and fallback not in self.units:
+            fallback = self._gone.get(fallback)
+        unit.fallback = fallback
+        return fallback
+
+    def _fallback(self, unit: RecoveryUnit) -> BlockHash | None:
+        """The deepest unit before ``unit`` on its path: its graph parent or
+        an aligned unit among its page keys."""
+        units = self.units
+        best, best_tokens = None, -1
+        parent = units.get(unit.parent) if unit.parent is not None else None
+        if (
+            parent is not None
+            and parent is not unit
+            and parent.num_tokens < unit.num_tokens
+        ):
+            best, best_tokens = parent.key, parent.num_tokens
+        path = unit.path
+        for j in range(len(path) - 1, -1, -1):
+            found = units.get(path[j])
+            if (
+                found is None
+                or found is unit
+                or found.frontier
+                or found.num_tokens >= unit.num_tokens
+            ):
+                continue
+            if found.num_tokens > best_tokens:
+                best = found.key
+            break
+        unit.fallback = best
+        return best
+
+    def _state_blocks(self, unit: RecoveryUnit) -> list[KVCacheBlock]:
+        cached = self.pool.cached_block_hash_to_block
+        return [
+            b
+            for group_id in (self.every if unit.frontier else self.mamba)
+            for b in cached.get_all_blocks(
+                make_block_hash_with_group_id(unit.key, group_id)
+            )
+        ]
+
+    def _exclusive(self, unit: RecoveryUnit) -> list[KVCacheBlock]:
+        """The page blocks of ``unit``'s exclusive chain, deepest first."""
+        units, cached = self.units, self.pool.cached_block_hash_to_block
+        out: list[KVCacheBlock] = []
+        for p in reversed(unit.path):
+            holders = self.on_path.get(p)
+            if holders is None or any(k in units and k != unit.key for k in holders):
+                break
+            for group_id in self.page_groups:
+                grouped = make_block_hash_with_group_id(p, group_id)
+                out.extend(cached.get_all_blocks(grouped))
+        return out
+
+    def _shared_pages(self, unit: RecoveryUnit) -> list[KVCacheBlock]:
+        """A frontier's pages that are also cached under a key of their own
+        (a hash unit finer than the block): evicting the frontier only removes
+        its key from them."""
+        if not unit.frontier:
+            return []
+        cached = self.pool.cached_block_hash_to_block
+        return [
+            b
+            for group_id in self.page_groups
+            for grouped in (make_block_hash_with_group_id(unit.key, group_id),)
+            for b in cached.get_all_blocks(grouped)
+            if b.block_hash != grouped
+        ]
+
+    def _size(self, unit: RecoveryUnit) -> int:
+        if unit.dirty:
+            unit.size = max(
+                1,
+                len(self._state_blocks(unit))
+                - len(self._shared_pages(unit))
+                + len(self._exclusive(unit)),
+            )
+            unit.dirty = False
+        return unit.size
+
+    def _gain(self, unit: RecoveryUnit) -> float:
+        if unit.dead:
+            return 0.0
+        fallback = self._resolve(unit)
+        base = self.units[fallback].num_tokens if fallback is not None else 0
+        if unit.num_tokens <= base:
+            return 0.0
+        return max(0.0, self.cost.seconds(base, unit.num_tokens))
+
+    def _score(self, unit: RecoveryUnit) -> _Score:
+        score = unit.stamp + self._gain(unit) / self._size(unit)
+        if not self.leaf_last:
+            return (score,)
+        unit.tier = self._tier(unit)
+        return (unit.tier, score)
+
+    def _orphan_score(self) -> _Score:
+        return (_DEAD, self.clock) if self.leaf_last else (self.clock,)
+
+    def _tier(self, unit: RecoveryUnit) -> int:
+        """Dead (it cannot be hit), inner (a deeper live unit on its path, and
+        not a branch point) or leaf."""
+        if unit.dead:
+            return _DEAD
+        if not self._deeper(unit):
+            if (
+                self._demote_s is not None
+                and time.monotonic() - unit.used_at > self._demote_s
+            ):
+                return _INNER
+            return _LEAF
+        if unit.is_branch_point or self._forks(unit):
+            return _LEAF
+        return _INNER
+
+    def _deeper(self, unit: RecoveryUnit) -> bool:
+        """A live unit deeper than ``unit`` holds its key as a page, or is its
+        child in the graph."""
+        units = self.units
+        for k in (*self.on_path.get(unit.key, ()), *unit.children):
+            other = units.get(k)
+            if (
+                other is not None
+                and other is not unit
+                and other.num_tokens > unit.num_tokens
+            ):
+                return True
+        return False
+
+    def _forks(self, unit: RecoveryUnit) -> bool:
+        """Two live units deeper than ``unit`` whose paths part in the full
+        block right after it."""
+        j = unit.num_tokens // self.block_size
+        first = None
+        for k in self.on_path.get(unit.key, ()):
+            other = self.units.get(k)
+            if (
+                other is None
+                or other is unit
+                or other.num_tokens <= unit.num_tokens
+                or len(other.path) <= j
+            ):
+                continue
+            if first is None:
+                first = other.path[j]
+            elif other.path[j] != first:
+                return True
+        return False
+
+    def _recheck(self, unit: RecoveryUnit | None) -> None:
+        """``unit``'s tier may have fallen: a unit last scored as a leaf is
+        pushed again at its score now."""
+        if unit is not None and unit.tier == _LEAF:
+            self._push(unit)
+
+    def _push(self, unit: RecoveryUnit) -> None:
+        if self.units.get(unit.key) is not unit:
+            return
+        unit.version = next(self._seq)
+        heapq.heappush(self.heap, (self._score(unit), unit.version, unit.key))
+
+    def _push_orphan(self, block: KVCacheBlock) -> None:
+        if block.block_id in self._orphans:
+            return
+        self._orphans.add(block.block_id)
+        heapq.heappush(self.heap, (self._orphan_score(), next(self._seq), block))
+
+    def _live(self, entry: _Entry) -> bool:
+        _score, seq, ref = entry
+        if isinstance(ref, KVCacheBlock):
+            return ref.block_id in self._orphans
+        unit = self.units.get(ref)
+        return unit is not None and unit.version == seq
+
+    def _keys(self, block: KVCacheBlock) -> list[BlockHashWithGroupId]:
+        """Every prefix-cache key ``block`` holds, its own hash last."""
+        keys = list(self.pool.cached_block_hashes_by_block.get(block.block_id, ()))
+        if block.block_hash is not None:
+            keys.append(block.block_hash)
+        return keys
+
+    def _keyed(self, block: KVCacheBlock) -> bool:
+        return (
+            block.block_hash is not None
+            or block.block_id in self.pool.cached_block_hashes_by_block
+        )
+
+    def _orphan(self, block: KVCacheBlock) -> bool:
+        """A free cached block no unit needs."""
+        if block.is_null or block.ref_cnt or block.prev_free_block is None:
+            return False
+        keys = self._keys(block)
+        if not keys:
+            return False
+        for grouped in keys:
+            key = get_block_hash(grouped)
+            if key in self.units:
+                return False
+            if get_group_id(grouped) in self.page_groups and any(
+                k in self.units for k in self.on_path.get(key, ())
+            ):
+                return False
+        return True
+
+    def _free(self, unit: RecoveryUnit) -> bool:
+        blocks = self._state_blocks(unit)
+        return bool(blocks) and all(b.ref_cnt == 0 for b in blocks)
+
+    def _pinned(self, unit: RecoveryUnit) -> bool:
+        pinned = self._pinned_blocks
+        return bool(pinned) and any(
+            b.block_id in pinned for b in self._state_blocks(unit)
+        )
+
+    def _keyless_front(self) -> bool:
+        queue = self.pool.free_block_queue
+        node = queue.fake_free_list_head.next_free_block
+        return (
+            node is not None
+            and node is not queue.fake_free_list_tail
+            and not self._keyed(node)
+        )
+
+    def _admit(self, unit: RecoveryUnit) -> None:
+        """``unit``'s blocks are free. Under pressure (no keyless free block) a
+        unit whose score is below every other's goes at once."""
+        self._fresh.discard(unit.key)
+        if self._keyless_front():
+            return
+        low = self._lowest(unit.key)
+        if low is not None and self._score(unit) < low:
+            self._to_front(self._evict(unit))
+
+    def _lowest(self, exclude: BlockHash) -> _Score | None:
+        """The lowest score of a live entry other than ``exclude``'s; stale
+        entries on the way out of the heap are dropped."""
+        heap, stash = self.heap, []
+        low = None
+        while heap:
+            entry = heap[0]
+            if not self._live(entry):
+                heapq.heappop(heap)
+                continue
+            ref = entry[2]
+            if not isinstance(ref, KVCacheBlock) and ref == exclude:
+                stash.append(heapq.heappop(heap))
+                continue
+            low = entry[0]
+            break
+        for entry in stash:
+            heapq.heappush(heap, entry)
+        return low
+
+    # Eviction.
+    def _reorder(self, num_blocks: int) -> None:
+        queue = self.pool.free_block_queue
+        end = queue.fake_free_list_tail
+        node = queue.fake_free_list_head.next_free_block
+        ready = 0
+        while (
+            ready < num_blocks
+            and node is not None
+            and node is not end
+            and not self._keyed(node)
+        ):
+            ready += 1
+            node = node.next_free_block
+        need = num_blocks - ready
+        out: list[KVCacheBlock] = []
+        while len(out) < need:
+            blocks = self._pop()
+            if blocks is None:
+                break
+            out.extend(blocks)
+        self._to_front(out)
+        if len(out) < need:
+            self._pool_order(need - len(out))
+
+    def _pop(self) -> list[KVCacheBlock] | None:
+        """Evict the free unit or orphan with the lowest score; its freed
+        blocks, or None when none is left."""
+        heap = self.heap
+        while heap:
+            score, seq, ref = heap[0]
+            if isinstance(ref, KVCacheBlock):
+                heapq.heappop(heap)
+                self._orphans.discard(ref.block_id)
+                if self._orphan(ref):
+                    with self.pool.removing("orphan"):
+                        self.pool._maybe_evict_cached_block(ref)
+                    return [ref]
+                continue
+            unit = self.units.get(ref)
+            if unit is None or unit.version != seq:
+                heapq.heappop(heap)
+                continue
+            now = self._score(unit)
+            if now > score:
+                unit.version = next(self._seq)
+                heapq.heapreplace(heap, (now, unit.version, ref))
+                continue
+            heapq.heappop(heap)
+            if not self._free(unit) or self._pinned(unit):
+                self._parked[ref] = unit
+                continue
+            if not self.leaf_last or unit.tier == _LEAF:
+                self.clock = max(self.clock, now[-1])
+            blocks = self._evict(unit)
+            self.num_evicted_units += 1
+            self.num_evicted_blocks += len(blocks)
+            return blocks
+        return None
+
+    def _evict(self, unit: RecoveryUnit) -> list[KVCacheBlock]:
+        """Drop ``unit``'s keys: its state blocks, then its exclusive pages,
+        deepest first. Returns the freed blocks. A frontier's page cached under
+        a key of its own as well keeps that key and is not freed."""
+        shared = self._shared_pages(unit)
+        kept = {b.block_id for b in shared}
+        blocks = [
+            b
+            for b in self._state_blocks(unit) + self._exclusive(unit)
+            if b.ref_cnt == 0 and b.block_id not in kept
+        ]
+        self._drop(unit, orphans=False)
+        self.evicting, self.evicting_blocks = unit.key, len(blocks)
+        with self.pool.removing(f"evicted-{TIER_NAMES.get(unit.tier, 'unranked')}"):
+            for b in shared:
+                assert b.block_hash is not None
+                group_id = get_group_id(b.block_hash)
+                self.pool.uncache_key(
+                    b, make_block_hash_with_group_id(unit.key, group_id)
+                )
+            for b in blocks:
+                self.pool._maybe_evict_cached_block(b)
+        self.evicting = None
+        return blocks
+
+    def _to_front(self, blocks: list[KVCacheBlock]) -> None:
+        queue = self.pool.free_block_queue
+        moved = [b for b in blocks if b.prev_free_block is not None]
+        for b in moved:
+            queue.remove(b)
+        queue.prepend_n(moved)
+
+    def _pool_order(self, n: int) -> None:
+        """No free unit is left: the next ``n`` keyed free blocks in the pool's
+        order, pinned ones last, the waiting queue's back first."""
+        queue = self.pool.free_block_queue
+        end = queue.fake_free_list_tail
+        node = queue.fake_free_list_head.next_free_block
+        picked: list[KVCacheBlock] = []
+        pinned: list[KVCacheBlock] = []
+        while node is not None and node is not end and len(picked) < n:
+            if self._keyed(node):
+                (pinned if node.block_id in self._pinned_blocks else picked).append(
+                    node
+                )
+            node = node.next_free_block
+        if len(picked) < n:
+            pinned.sort(key=lambda block: -self._pinned_blocks[block.block_id])
+            picked += pinned[: n - len(picked)]
+        self._to_front(picked)
+
+    # Per step.
+    def new_step(self) -> None:
+        self._refresh_pins()
+        self.settle()
+
+    def _refresh_pins(self) -> None:
+        """Pin the blocks the waiting requests' prefix hits read."""
+        now = time.monotonic()
+        if now - self._pinned_at < _PIN_REFRESH_S:
+            return
+        self._pinned_at = now
+        pinned: dict[int, int] = {}
+        budget = _PIN_UNITS
+        for rank, request in enumerate(itertools.islice(self.waiting(), _PIN_WINDOW)):
+            budget -= request.num_tokens // self.pool.hash_block_size + 1
+            if budget < 0:
+                break
+            max_length = max(request.num_tokens - 1, 0)
+            blocks, hit, _ = self.coordinator.find_longest_cache_hit(
+                request.block_hashes, max_length
+            )
+            blocks, hit = self.frontiers.peek_blocks(request, blocks, hit, max_length)
+            if not hit:
+                continue
+            for group in blocks:
+                for block in group:
+                    if not block.is_null:
+                        pinned.setdefault(block.block_id, rank)
+        self._pinned_blocks = pinned
+
+    def settle(self) -> None:
+        """Bookkeeping outside allocations: removed units leave their pages'
+        sets; parked units that are free and unpinned, and fresh ones, are
+        pushed or admitted."""
+        units = self.units
+        for unit in self._removed_units:
+            if unit.key in units:
+                continue
+            for p in unit.path:
+                holders = self.on_path.get(p)
+                if holders is not None:
+                    holders.discard(unit.key)
+                    if not holders:
+                        del self.on_path[p]
+        self._removed_units.clear()
+        for key, unit in list(self._parked.items()):
+            if units.get(key) is not unit:
+                del self._parked[key]
+            elif self._free(unit) and not self._pinned(unit):
+                del self._parked[key]
+                self._push(unit)
+        for key in list(self._fresh):
+            fresh = units.get(key)
+            if fresh is None:
+                self._fresh.discard(key)
+            elif self._free(fresh):
+                self._admit(fresh)
+        if self._demote_s is not None:
+            # Leaves unused for leaf_idle_s rank as inner from now: pushed again
+            # at their lower score.
+            recent, cut = self._recent, time.monotonic() - self._demote_s
+            while recent and recent[0][0] < cut:
+                at, key = recent.popleft()
+                idle = units.get(key)
+                if idle is not None and idle.used_at == at and idle.tier == _LEAF:
+                    self._push(idle)
+        if len(self._gone) > 2 * len(units) + _GONE:
+            for unit in units.values():
+                self._resolve(unit)
+            self._gone.clear()
+        if (
+            len(self.heap)
+            > _HEAP_FACTOR * (len(units) + len(self._orphans)) + _HEAP_SLACK
+        ):
+            self.heap = [entry for entry in self.heap if self._live(entry)]
+            heapq.heapify(self.heap)
+
+    def reset(self) -> None:
+        """The prefix cache was reset."""
+        self.units.clear()
+        self.on_path.clear()
+        self.heap.clear()
+        self.paths.clear()
+        self._gone.clear()
+        self._removed_units.clear()
+        self._parked.clear()
+        self._fresh.clear()
+        self._orphans.clear()
+        self._recent.clear()
+        self._pinned_blocks.clear()
+        self._pinned_at = float("-inf")
diff --git a/vllm/v1/core/hybrid_checkpoint/export.py b/vllm/v1/core/hybrid_checkpoint/export.py
new file mode 100644
index 0000000..777366a
--- /dev/null
+++ b/vllm/v1/core/hybrid_checkpoint/export.py
@@ -0,0 +1,118 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""In-chunk Mamba state export (``mamba_prefill_export``).
+
+In align mode a non-final prefill chunk ends at every position where a
+Mamba state must be cached (a block boundary after a mid-block start, the
+last cacheable boundary, a shared-prefix junction), so an early stop costs a
+forward pass with a short chunk. With export, a non-final chunk may run past
+one such position and have the backend write the state there with its
+prefill checkpoint, which the scheduler, ``MambaManager`` and the worker all
+take from the scheduler's per-request position. A chunk that the aligned
+split cannot fill at all may instead end on a 64-token boundary.
+"""
+
+from typing import TYPE_CHECKING
+
+from vllm.v1.kv_cache_interface import is_mamba_prefill_checkpoint_valid
+
+if TYPE_CHECKING:
+    from vllm.config import VllmConfig
+
+# A filler chunk ends on a multiple of this many tokens and has at least
+# _FILLER_MIN_TOKENS of them.
+_FILLER_ALIGNMENT = 64
+_FILLER_MIN_TOKENS = 1024
+
+
+def plan_export(
+    start: int,
+    candidate_end: int,
+    stops: tuple[int, ...],
+    *,
+    alignment: int | None,
+    hash_block_size: int,
+    block_size: int,
+) -> tuple[int, int | None]:
+    """End a non-final chunk so that it contains at most one of ``stops``.
+
+    ``candidate_end`` is where the chunk would end without stops. The first
+    stop inside it is exported when the backend's checkpoint can write it
+    (``is_mamba_prefill_checkpoint_valid``); the chunk then ends at the
+    second stop, if any. A first stop that cannot be written ends the chunk.
+
+    Returns:
+        The chunk end and the exported position, or None.
+
+    """
+    if candidate_end <= start:
+        return start, None
+    interior = sorted(pos for pos in stops if start < pos < candidate_end)
+    if not interior:
+        return candidate_end, None
+    first = interior[0]
+    end = candidate_end if len(interior) == 1 else interior[1]
+    if alignment is None or (first - start) % alignment:
+        return first, None
+    if not is_mamba_prefill_checkpoint_valid(
+        query_start=start,
+        query_end=end,
+        checkpoint_position=first,
+        hash_block_size=hash_block_size,
+        mamba_block_size=block_size,
+        checkpoint_alignment=alignment,
+    ):
+        return first, None
+    return end, first
+
+
+def plan_filler(
+    start: int,
+    num_new_tokens: int,
+    *,
+    prefill_end: int,
+    stops: tuple[int, ...],
+) -> int:
+    """Tokens of a filler chunk for a non-final chunk the aligned split could
+    not schedule: up to ``num_new_tokens``, ending on a 64-token boundary
+    before any of ``stops``, or 0 when that leaves fewer than 1024."""
+    if start >= prefill_end or num_new_tokens >= prefill_end - start:
+        return 0
+    take = num_new_tokens // _FILLER_ALIGNMENT * _FILLER_ALIGNMENT
+    inner = [pos for pos in stops if start < pos < start + take]
+    if take > 0 and inner:
+        take = (min(inner) - start) // _FILLER_ALIGNMENT * _FILLER_ALIGNMENT
+    return take if take >= _FILLER_MIN_TOKENS else 0
+
+
+def check_prefill_export_config(
+    vllm_config: "VllmConfig",
+    *,
+    use_v2_model_runner: bool,
+    checkpoint_alignment: int | None,
+    has_checkpoint_blocks: bool,
+) -> None:
+    """Raise unless in-chunk export can run with this configuration."""
+    refusal = None
+    if vllm_config.cache_config.mamba_cache_mode != "align":
+        refusal = "prefix caching with mamba_cache_mode 'align'"
+    elif not use_v2_model_runner:
+        refusal = "Model Runner V2"
+    elif checkpoint_alignment is None or not has_checkpoint_blocks:
+        refusal = "a backend that writes prefill checkpoints in every Mamba group"
+    elif (
+        vllm_config.speculative_config is not None
+        and vllm_config.speculative_config.use_eagle_block_drop()
+    ):
+        # An exported position follows neither the EAGLE block drop nor the
+        # lookahead block hashes that replace it.
+        refusal = "speculative_config.disable_eagle_block_drop"
+    elif vllm_config.parallel_config.use_ubatching:
+        refusal = "no ubatching"
+    elif (
+        vllm_config.parallel_config.decode_context_parallel_size != 1
+        or vllm_config.parallel_config.prefill_context_parallel_size != 1
+    ):
+        refusal = "decode and prefill context parallel size 1"
+    if refusal is not None:
+        raise ValueError(f"mamba_prefill_export needs {refusal}")
diff --git a/vllm/v1/core/hybrid_checkpoint/frontier.py b/vllm/v1/core/hybrid_checkpoint/frontier.py
new file mode 100644
index 0000000..f72442a
--- /dev/null
+++ b/vllm/v1/core/hybrid_checkpoint/frontier.py
@@ -0,0 +1,567 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Frontier checkpoints: a finished request's state at its exact end.
+
+For a freed request that processed ``L`` tokens, ``L`` inside block ``k``, a
+frontier checkpoint is the attention page holding ``[kB, L)`` in every
+full-attention group, the running state block in every Mamba group and, when
+``L`` is inside an indexer compression pool, the indexer's ring block. Each
+block is cached under ``(key, group)`` with the frontier key of ``L``
+(``keys.frontier_key``). A later request whose tokens extend those ``L``
+tokens resumes at ``L``: upstream's partial-hit copy-on-write gives it private
+copies of the page and the state, and the ring is copied when it is claimed.
+The checkpoint is usable only while every one of its blocks is cached; when
+any of them is evicted the others lose the key too.
+
+Under speculative decoding the state's length and block come from the
+request's last steps (``speculative.ExactState``). A state in a later draft
+column is folded into the step's first column on the device before anything
+reads it; such gathers wait in ``pending_gathers`` for the next step.
+"""
+
+import math
+from collections.abc import Callable
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any
+
+from vllm.utils.math_utils import cdiv
+from vllm.v1.core.hybrid_checkpoint.keys import frontier_key
+from vllm.v1.core.hybrid_checkpoint.speculative import ExactState
+from vllm.v1.core.kv_cache_utils import (
+    BlockHash,
+    BlockHashWithGroupId,
+    KVCacheBlock,
+    get_block_hash,
+    make_block_hash_with_group_id,
+)
+from vllm.v1.core.single_type_kv_cache_manager import (
+    CircularBufferManager,
+    MambaManager,
+)
+from vllm.v1.kv_cache_interface import CircularBufferSpec
+from vllm.v1.request import RequestStatus
+
+if TYPE_CHECKING:
+    from vllm.v1.core.kv_cache_coordinator import KVCacheCoordinator
+    from vllm.v1.request import Request
+
+# Tokens before the frontier compared ahead of the key, so that a lookup
+# hashes only candidates that already end like the request.
+_SUFFIX = 8
+
+HitBlocks = tuple[list[KVCacheBlock], ...]
+
+
+@dataclass(slots=True)
+class StateGather:
+    """Fold draft column ``column`` into the first column of a published
+    state: Mamba group id -> (first column's block, the column's block).
+    ``key``: the frontier it completes."""
+
+    column: int
+    blocks: dict[int, tuple[KVCacheBlock, KVCacheBlock]]
+    key: BlockHash | None = None
+
+
+@dataclass(frozen=True, slots=True)
+class FrontierCheckpoint:
+    """A finished request's frontier checkpoint, as a KV connector that keeps
+    it in an external store sees it (``FrontierIndex.checkpoint``).
+
+    Attributes:
+        key: The frontier key of ``num_tokens``.
+        num_tokens: The tokens the state follows, inside block ``k``.
+        blocks: Group id -> the checkpoint's block there: the page holding
+            ``[kB, num_tokens)``, the running state and, inside an indexer
+            pool, the ring.
+        pages: Full-attention group id -> the request's page block ids
+            ``[0, k)``.
+
+    """
+
+    key: BlockHash
+    num_tokens: int
+    blocks: dict[int, int]
+    pages: dict[int, tuple[int, ...]]
+
+
+@dataclass(slots=True)
+class _Frontier:
+    key: BlockHash
+    anchor: BlockHash | None
+    num_tokens: int
+    suffix: tuple[int, ...]
+    # Group id -> the block cached under (key, group).
+    blocks: dict[int, KVCacheBlock]
+
+
+@dataclass(slots=True)
+class _Lookup:
+    hit: int
+    num_tokens: int
+    key: BlockHash | None
+    # Live frontiers equal to the request's tokens but for their last token.
+    stale: tuple[BlockHash, ...]
+
+
+class FrontierIndex:
+    def __init__(
+        self,
+        coordinator: "KVCacheCoordinator",
+        hash_fn: Callable[[Any], bytes],
+        pages: list[int],
+        states: list[int],
+        rings: list[int],
+    ) -> None:
+        self.pool = coordinator.block_pool
+        self.managers = coordinator.single_type_managers
+        self.block_size = coordinator.scheduler_block_size
+        self.hash_block_size = self.pool.hash_block_size
+        self.hash_fn = hash_fn
+        self.pages = pages
+        self.states = states
+        self.rings = rings
+        group_sizes = []
+        for group_id in rings:
+            ring = self.managers[group_id]
+            assert isinstance(ring, CircularBufferManager)
+            assert isinstance(ring.kv_cache_spec, CircularBufferSpec)
+            ring.takes_frontier_hits = True
+            group_sizes.append(ring.kv_cache_spec.group_size)
+        # A frontier inside this many tokens' pool also keeps the ring.
+        self.pool_size = math.lcm(1, *group_sizes)
+        # Gathers of published states, applied by the next step.
+        self.pending_gathers: list[StateGather] = []
+        # Free blocks that lose their keys go to the front of the free queue.
+        self.reclaim = False
+        self.entries: dict[BlockHash, _Frontier] = {}
+        # anchor -> num_tokens -> suffix -> keys
+        self._index: dict[
+            BlockHash | None, dict[int, dict[tuple[int, ...], list[BlockHash]]]
+        ] = {}
+        self._lookups: dict[str, _Lookup] = {}
+        # Admitted request -> stale frontiers its lookup found, which its
+        # finish may release.
+        self.superseded: dict[str, tuple[BlockHash, ...]] = {}
+        self.num_published = 0
+        self.num_hits = 0
+        self.num_hit_tokens = 0
+        self.num_removed = 0
+
+    def publish(
+        self, request: "Request", exact: ExactState | None = None
+    ) -> BlockHash | None:
+        """Cache the freed request's state at its processed frontier in every
+        group, or in none. Under speculative decoding ``exact`` says where
+        that state is. Returns the key."""
+        self._lookups.pop(request.request_id, None)
+        num_tokens = request.num_computed_tokens if exact is None else exact.num_tokens
+        if (
+            num_tokens == 0
+            or num_tokens % self.block_size == 0
+            or request.resumable
+            or request.status == RequestStatus.FINISHED_ABORTED
+            # An input token of a dispatched step is not known yet.
+            or request.num_tokens < num_tokens
+        ):
+            return None
+        found = self._frontier_blocks(request, num_tokens, exact)
+        if found is None:
+            return None
+        blocks, gather = found
+        key = frontier_key(self.hash_fn, request, num_tokens, self.hash_block_size)
+        if key in self.entries:
+            return None
+        if gather is not None:
+            # Both ends stay referenced until the step that runs the gather.
+            for dst, src in gather.blocks.values():
+                dst.ref_cnt += 1
+                src.ref_cnt += 1
+            gather.key = key
+            self.pending_gathers.append(gather)
+        h = num_tokens // self.hash_block_size
+        anchor = request.block_hashes[h - 1] if h else None
+        for group_id, block in blocks.items():
+            self.pool.cache_block_under_key(
+                block,
+                make_block_hash_with_group_id(key, group_id),
+                num_tokens,
+                request,
+                anchor,
+            )
+        start = max(h * self.hash_block_size, num_tokens - _SUFFIX)
+        suffix = tuple(request.all_token_ids[start:num_tokens])
+        self.entries[key] = _Frontier(key, anchor, num_tokens, suffix, blocks)
+        by_length = self._index.setdefault(anchor, {}).setdefault(num_tokens, {})
+        by_length.setdefault(suffix, []).append(key)
+        self.num_published += 1
+        return key
+
+    def checkpoint(
+        self, request: "Request", exact: ExactState | None = None
+    ) -> FrontierCheckpoint | None:
+        """The freed request's frontier checkpoint for an external store, or
+        None when it has none. Under speculative decoding ``exact`` says where
+        the state is; a state that still waits for its draft-column gather
+        gives none. It does not depend on whether ``publish`` caches the
+        checkpoint here, and must run before it."""
+        num_tokens = request.num_computed_tokens if exact is None else exact.num_tokens
+        if (
+            num_tokens == 0
+            or num_tokens % self.block_size == 0
+            or request.resumable
+            or request.status == RequestStatus.FINISHED_ABORTED
+            or request.num_tokens < num_tokens
+        ):
+            return None
+        found = self._frontier_blocks(request, num_tokens, exact)
+        if found is None:
+            return None
+        blocks, gather = found
+        if gather is not None:
+            return None
+        k = num_tokens // self.block_size
+        pages: dict[int, tuple[int, ...]] = {}
+        for group_id in self.pages:
+            table = self.managers[group_id].req_to_blocks[request.request_id][:k]
+            if any(block.is_null for block in table):
+                return None
+            pages[group_id] = tuple(block.block_id for block in table)
+        return FrontierCheckpoint(
+            key=frontier_key(self.hash_fn, request, num_tokens, self.hash_block_size),
+            num_tokens=num_tokens,
+            blocks={group_id: block.block_id for group_id, block in blocks.items()},
+            pages=pages,
+        )
+
+    def _frontier_blocks(
+        self, request: "Request", num_tokens: int, exact: ExactState | None
+    ) -> tuple[dict[int, KVCacheBlock], StateGather | None] | None:
+        """The block to cache in every group and, when the state is in a later
+        draft column, the gather that completes it."""
+        request_id = request.request_id
+        k = num_tokens // self.block_size
+        blocks: dict[int, KVCacheBlock] = {}
+        for group_id in self.pages:
+            table = self.managers[group_id].req_to_blocks.get(request_id) or []
+            if len(table) <= k:
+                return None
+            blocks[group_id] = table[k]
+        running = cdiv(num_tokens, self.block_size) - 1
+        gather = None
+        for group_id in self.states:
+            manager = self.managers[group_id]
+            table = manager.req_to_blocks.get(request_id) or []
+            if exact is None:
+                # Align mode keeps the running state in the last block.
+                if len(table) != running + 1:
+                    return None
+                blocks[group_id] = table[running]
+                continue
+            assert isinstance(manager, MambaManager)
+            dst, src = exact.block_indices(
+                self.block_size, manager.num_speculative_blocks
+            )
+            if src >= len(table) or table[src].is_null:
+                return None
+            blocks[group_id] = table[dst]
+            if src != dst:
+                if gather is None:
+                    gather = StateGather(exact.column, {})
+                gather.blocks[group_id] = (table[dst], table[src])
+        if num_tokens % self.pool_size:
+            for group_id in self.rings:
+                table = self.managers[group_id].req_to_blocks.get(request_id) or []
+                if len(table) != 1:
+                    return None
+                blocks[group_id] = table[0]
+        keyed = self.pool.cached_block_hashes_by_block
+        units_per_block = self.block_size // self.hash_block_size
+        for group_id, block in blocks.items():
+            if block.is_null:
+                return None
+            # With a hash unit finer than the block, the page may already be
+            # cached under the request's own key at a hash-unit boundary inside
+            # it; the frontier key joins that key.
+            if (block.block_hash is not None or block.block_id in keyed) and (
+                group_id not in self.pages or units_per_block == 1
+            ):
+                return None
+        return blocks, gather
+
+    def extend(
+        self,
+        request: "Request",
+        blocks: HitBlocks,
+        hit: int,
+        max_length: int,
+    ) -> tuple[HitBlocks, int]:
+        """``(blocks, hit)`` resumed at the longest frontier past ``hit`` that
+        ``request``'s tokens extend, or the arguments unchanged."""
+        stale: list[BlockHash] = []
+        found = self._lookup(request, blocks, hit, max_length, stale=stale)
+        if found is None:
+            self._lookups[request.request_id] = _Lookup(hit, 0, None, tuple(stale))
+            return blocks, hit
+        entry, k, pages = found
+        self._lookups[request.request_id] = _Lookup(
+            hit, entry.num_tokens, entry.key, tuple(stale)
+        )
+        return self._hit_blocks(blocks, pages, entry, k), entry.num_tokens
+
+    def peek_blocks(
+        self,
+        request: "Request",
+        blocks: HitBlocks,
+        hit: int,
+        max_length: int,
+    ) -> tuple[HitBlocks, int]:
+        """What ``extend`` would return, recording and removing nothing."""
+        found = self._lookup(request, blocks, hit, max_length, stale=None)
+        if found is None:
+            return blocks, hit
+        entry, k, pages = found
+        return self._hit_blocks(blocks, pages, entry, k), entry.num_tokens
+
+    def cached_pages(
+        self, request: "Request", blocks: HitBlocks, hit: int, end_block: int
+    ) -> tuple[HitBlocks, int]:
+        """``blocks``, a block-aligned hit of ``hit`` tokens, extended by the
+        full-attention pages ``[hit // B, j)`` cached under the request's own
+        block hashes (a block's is the hash at its last hash unit), ``j <=
+        end_block`` the first one missing, with the Mamba groups padded with
+        null blocks to ``j`` blocks, and ``j * B``. For a request whose state
+        at a later position an external load supplies: the local hit ends at
+        the deepest state every group caches, often before pages the GPU
+        still holds. The arguments come back unchanged when no page is cached
+        there or the hit holds a ring."""
+        start = hit // self.block_size
+        assert hit == start * self.block_size, hit
+        if any(blocks[group_id] for group_id in self.rings):
+            return blocks, hit
+        per_block = self.block_size // self.hash_block_size
+        end_block = min(end_block, len(request.block_hashes) // per_block)
+        pages = {g: list(blocks[g][:start]) for g in self.pages}
+        j = start
+        while j < end_block:
+            found = self.pool.get_cached_block(
+                request.block_hashes[(j + 1) * per_block - 1], self.pages
+            )
+            if found is None:
+                break
+            for group_id, block in zip(self.pages, found):
+                pages[group_id].append(block)
+            j += 1
+        if j == start:
+            return blocks, hit
+        extended = list(blocks)
+        for group_id in self.pages:
+            extended[group_id] = pages[group_id]
+        for group_id in self.states:
+            extended[group_id] = [self.pool.null_block] * j
+        return tuple(extended), j * self.block_size
+
+    def resumed_at(self, request_id: str, num_computed_tokens: int) -> BlockHash | None:
+        """The frontier the request's latest lookup resumes it at, when it is
+        admitted at that frontier's length."""
+        lookup = self._lookups.get(request_id)
+        if lookup is None or lookup.num_tokens != num_computed_tokens:
+            return None
+        return lookup.key
+
+    def _lookup(
+        self,
+        request: "Request",
+        blocks: HitBlocks,
+        hit: int,
+        max_length: int,
+        *,
+        stale: list[BlockHash] | None,
+    ) -> tuple[_Frontier, int, dict[int, list[KVCacheBlock]]] | None:
+        """``stale`` (None for a read-only lookup) collects the live frontiers
+        found equal to the request's tokens but for their last token."""
+        unit = self.hash_block_size
+        tokens = request.all_token_ids
+        for h in range(max_length // unit, hit // unit - 1, -1):
+            anchor = request.block_hashes[h - 1] if h else None
+            lengths = self._index.get(anchor)
+            if not lengths:
+                continue
+            for num_tokens in sorted(lengths, reverse=True):
+                if num_tokens > max_length:
+                    continue
+                if num_tokens <= hit:
+                    break
+                start = max(h * unit, num_tokens - _SUFFIX)
+                suffix = tuple(tokens[start:num_tokens])
+                keys = lengths[num_tokens].get(suffix, ())
+                if not keys:
+                    if stale is not None:
+                        last = self._mismatch_last(
+                            request, num_tokens, suffix, lengths[num_tokens]
+                        )
+                        if last is not None:
+                            stale.append(last)
+                    continue
+                expected = frontier_key(self.hash_fn, request, num_tokens, unit)
+                if expected not in keys:
+                    continue
+                entry = self.entries[expected]
+                if not self._still_cached(entry):
+                    if stale is not None:
+                        self._remove(entry)
+                    continue
+                k = num_tokens // self.block_size
+                pages = self._prefix_pages(request, blocks, hit, k)
+                if pages is None:
+                    continue
+                return entry, k, pages
+        return None
+
+    def _mismatch_last(
+        self,
+        request: "Request",
+        num_tokens: int,
+        suffix: tuple[int, ...],
+        by_suffix: dict[tuple[int, ...], list[BlockHash]],
+    ) -> BlockHash | None:
+        """The frontier of ``num_tokens`` tokens equal to the request's first
+        ``num_tokens`` tokens with only the last one different (an async stop
+        token the client replaced, say)."""
+        for other, keys in by_suffix.items():
+            if other[:-1] != suffix[:-1] or other[-1] == suffix[-1]:
+                continue
+            key = frontier_key(
+                self.hash_fn, request, num_tokens, self.hash_block_size, other[-1]
+            )
+            if key in keys:
+                return key
+        return None
+
+    def _still_cached(self, entry: _Frontier) -> bool:
+        cached = self.pool.cached_block_hash_to_block
+        return all(
+            cached.contain(make_block_hash_with_group_id(entry.key, g), b.block_id)
+            for g, b in entry.blocks.items()
+        )
+
+    def _prefix_pages(
+        self,
+        request: "Request",
+        blocks: HitBlocks,
+        hit: int,
+        k: int,
+    ) -> dict[int, list[KVCacheBlock]] | None:
+        """Full-attention blocks ``[0, k)``: the block-aligned hit's, then the
+        blocks cached under the request's own block hashes."""
+        num_hit_blocks = hit // self.block_size
+        pages = {g: list(blocks[g][:num_hit_blocks]) for g in self.pages}
+        per_block = self.block_size // self.hash_block_size
+        for i in range(num_hit_blocks, k):
+            found = self.pool.get_cached_block(
+                request.block_hashes[(i + 1) * per_block - 1], self.pages
+            )
+            if found is None:
+                return None
+            for group_id, block in zip(self.pages, found):
+                pages[group_id].append(block)
+        return pages
+
+    def _hit_blocks(
+        self,
+        blocks: HitBlocks,
+        pages: dict[int, list[KVCacheBlock]],
+        entry: _Frontier,
+        k: int,
+    ) -> HitBlocks:
+        hit = list(blocks)
+        for group_id in self.pages:
+            hit[group_id] = pages[group_id] + [entry.blocks[group_id]]
+        for group_id in self.states:
+            hit[group_id] = [self.pool.null_block] * k + [entry.blocks[group_id]]
+        for group_id in self.rings:
+            hit[group_id] = [entry.blocks[group_id]] if group_id in entry.blocks else []
+        return tuple(hit)
+
+    def hit_tokens(self, request_id: str, num_hits: int) -> int:
+        """The tokens past the block-aligned hit that a frontier serves the
+        request if it is admitted ``num_hits`` tokens in, else 0."""
+        lookup = self._lookups.get(request_id)
+        if lookup is None or lookup.key is None or num_hits != lookup.num_tokens:
+            return 0
+        return lookup.num_tokens - lookup.hit
+
+    def admitted(self, request: "Request", num_hits: int) -> None:
+        """The request was admitted ``num_hits`` tokens in."""
+        hit_tokens = self.hit_tokens(request.request_id, num_hits)
+        lookup = self._lookups.pop(request.request_id, None)
+        if lookup is None:
+            return
+        if lookup.stale:
+            self.superseded[request.request_id] = lookup.stale
+        else:
+            self.superseded.pop(request.request_id, None)
+        if hit_tokens:
+            self.num_hits += 1
+            self.num_hit_tokens += hit_tokens
+
+    def removed(self, keys: list[BlockHashWithGroupId]) -> None:
+        """A frontier missing any block cannot be hit; its other blocks lose
+        the key too."""
+        for grouped in keys:
+            entry = self.entries.get(get_block_hash(grouped))
+            if entry is not None:
+                self._remove(entry)
+
+    def drop(self, key: BlockHash) -> bool:
+        """Drop the frontier ``key`` in every group. False if it is none."""
+        entry = self.entries.get(key)
+        if entry is None:
+            return False
+        self._remove(entry)
+        return True
+
+    def _remove(self, entry: _Frontier) -> None:
+        del self.entries[entry.key]
+        lengths = self._index[entry.anchor]
+        suffixes = lengths[entry.num_tokens]
+        keys = suffixes[entry.suffix]
+        keys.remove(entry.key)
+        if not keys:
+            del suffixes[entry.suffix]
+            if not suffixes:
+                del lengths[entry.num_tokens]
+                if not lengths:
+                    del self._index[entry.anchor]
+        cached = self.pool.cached_block_hash_to_block
+        with self.pool.removing("frontier"):
+            for group_id, block in entry.blocks.items():
+                key = make_block_hash_with_group_id(entry.key, group_id)
+                if not cached.contain(key, block.block_id):
+                    continue
+                if block.block_hash != key:
+                    # A page that stays cached under the request's own key.
+                    self.pool.uncache_key(block, key)
+                else:
+                    self.pool._maybe_evict_cached_block(block)
+                    self.to_front(block)
+        self.num_removed += 1
+
+    def to_front(self, block: KVCacheBlock) -> None:
+        """With ``reclaim``: a free block that just lost its keys is reused
+        before any cached block."""
+        if not self.reclaim or block.ref_cnt or block.prev_free_block is None:
+            return
+        queue = self.pool.free_block_queue
+        queue.remove(block)
+        queue.prepend_n([block])
+
+    def forget(self, request_id: str) -> None:
+        """The request finished: its lookup goes."""
+        self._lookups.pop(request_id, None)
+
+    def reset(self) -> None:
+        self.entries.clear()
+        self._index.clear()
+        self._lookups.clear()
+        self.superseded.clear()
