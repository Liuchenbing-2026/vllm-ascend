+
+
+@overload
+def supports_compact_spec_state(model: object) -> TypeIs[SupportsCompactSpecState]: ...
+
+
+def supports_compact_spec_state(
+    model: type[object] | object,
+) -> TypeIs[type[SupportsCompactSpecState]] | TypeIs[SupportsCompactSpecState]:
