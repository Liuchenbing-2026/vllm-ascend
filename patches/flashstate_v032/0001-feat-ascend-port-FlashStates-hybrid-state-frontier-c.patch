+class RecoveryUnitRemoved(KVCacheEvent):
+    """A recovery unit stopped being resumable. ``cause`` is a
+    ``REMOVAL_CAUSES`` entry ("allocation" when no other path removed it);
+    ``tier`` is the eviction tier it was last ranked in ("dead", "interior"
+    or "leaf"; None if never ranked); ``num_blocks`` the blocks an eviction
+    freed with it (its state blocks and the pages only it needs). A prefix
+    cache reset removes every unit at once, with ``AllBlocksCleared``."""
+
+    unit_hash: ExternalBlockHash
+    num_tokens: int
+    frontier: bool
+    cause: str
+    tier: str | None = None
+    num_blocks: int | None = None
