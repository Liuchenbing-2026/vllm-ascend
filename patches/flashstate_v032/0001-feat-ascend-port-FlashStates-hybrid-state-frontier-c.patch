+REMOVAL_CAUSES = (
+    # A recovery unit the eviction policy chose, by the tier it was ranked in.
+    "evicted-dead",
+    "evicted-interior",
+    "evicted-leaf",
+    "evicted-unranked",
+    # A cached free block that no recovery unit needs.
