+"""CPU tests of real weight conversion; native dispatch is not executed."""
+import importlib.util
+from pathlib import Path
+import sys
+from types import ModuleType, SimpleNamespace
+from unittest.mock import Mock, patch
+
+import pytest
+import torch
+
+
+@pytest.fixture
+def mega():
+    # Load the actual Python module without importing the unavailable NPU extension.
+    parent = ModuleType('_host_deepgemm')
+    parent._C = SimpleNamespace(_mega_moe_block_n=256, fp8_fp4_mega_moe=Mock())
+    path = Path(__file__).parents[1] / 'deep_gemm/mega/__init__.py'
+    spec = importlib.util.spec_from_file_location('_host_deepgemm.mega', path)
+    module = importlib.util.module_from_spec(spec)
+    with patch.dict(sys.modules, {'_host_deepgemm': parent}):
+        spec.loader.exec_module(module)
+    return module
+
+
+@pytest.mark.parametrize('experts', [1, 2])
+def test_routed_fp8_bytes_and_scales(mega, experts):
+    hidden, intermediate = 256, 512
+    def pair(n, k):
+        data = (torch.arange(experts*n*k).reshape(experts,n,k) % 127).to(torch.uint8)
+        sf = (torch.arange(experts*n*(k//32)).reshape(experts,n,k//32) % 256).to(torch.uint8)
+        return data.view(torch.float8_e4m3fn), sf.view(torch.int16)
+    a, b = pair(2*intermediate,hidden), pair(hidden,intermediate)
+    original = [(w.view(torch.uint8).clone(), sf.view(torch.uint8).clone()) for w,sf in (a,b)]
+    converted = mega.transform_weights_for_mega_moe(a,b)
+    for linear, ((w,sf),(raw,raw_sf)) in enumerate(zip(converted,original)):
+        n,k = raw.shape[-2:]
+        assert w.dtype == torch.float8_e4m3fn and sf.dtype == torch.int16
+        for e in range(experts):
+            for row in range(n):
+                if linear == 0:
+                    half = n//2
+                    destination = (row%half//128)*256 + (row//half)*128 + row%128
+                else:
+                    destination = row
+                block,lane = divmod(destination,256)
+                # Independent decode of physical NZ bytes and packed exponent pairs.
+                nz = w[e,block].view(torch.uint8).flatten().reshape(k//32,256,32)
+                assert torch.equal(nz[:,lane,:].flatten(),raw[e,row])
+                restored_sf = sf[e,block,:,lane].contiguous().view(torch.uint8)
+                assert torch.equal(restored_sf,raw_sf[e,row])
+        assert torch.equal((a,b)[linear][0].view(torch.uint8),raw)
+        assert torch.equal((a,b)[linear][1].view(torch.uint8),raw_sf)
+
+
+def test_fp4_scale_compensation_is_preserved(mega):
+    w = torch.zeros((1,512,128),dtype=torch.int8)
+    sf = torch.full((1,512,8),127,dtype=torch.uint8).view(torch.int16)
+    result,_ = mega.transform_weights_for_mega_moe((w,sf),(w,sf))
+    assert torch.all(result[1].view(torch.uint8) == 133)
+
+
+@pytest.mark.parametrize('bad_layer', [0,1])
+def test_weight_format_mismatch_fails_before_native_call(mega,bad_layer):
+    buffer=SimpleNamespace(mma_type='fp8xfp8')
+    weights=[(torch.zeros(1,dtype=torch.float8_e4m3fn),None) for _ in range(2)]
+    weights[bad_layer]=(torch.zeros(1,dtype=torch.int8),None)
+    with pytest.raises(ValueError,match='dtype'):
+        mega.fp8_fp4_mega_moe(None,*weights,buffer)
+    mega._C.fp8_fp4_mega_moe.assert_not_called()
+
+
+def test_old_native_extension_does_not_advertise_fp8(mega):
+    assert mega.SymmBuffer.supports_mma_type('fp8xfp4')
+    assert not mega.SymmBuffer.supports_mma_type('fp8xfp8')
+    mega._C._mega_moe_routed_fp8 = True
+    assert mega.SymmBuffer.supports_mma_type('fp8xfp8')
+    assert not mega.SymmBuffer.supports_mma_type('bf16xbf16')
